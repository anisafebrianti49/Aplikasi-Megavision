<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Trik menyembunyikan sisi atas, bawah, dan kiri, menyisakan garis kanan saja -->
    <item
        android:bottom="-5dp"
        android:left="-5dp"
        android:top="-5dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="#CCCCCC"
                android:dashGap="6dp"
                android:dashWidth="8dp" />
        </shape>
    </item>
</layer-list>