<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Toolbar biru -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/megavision_blue"
        app:elevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="8dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_back_white"
                android:background="@android:color/transparent"
                android:contentDescription="Kembali"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kebijakan &amp; Privasi"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- NestedScrollView untuk teks panjang yang mulus -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:overScrollMode="never">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="0dp"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Judul Dokumen -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MEGAVISION APPS\nPrivacy Policy"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:gravity="center"
                    android:layout_marginBottom="24dp" />

                <!-- Section 1 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Syarat dan Ketentuan atas Akses dan Penggunaan"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mohon untuk membaca syarat dan ketentuan ini dengan seksama. Dengan mengakses dan/atau menggunakan layanan Megavision melalui media apa pun, Anda setuju untuk terikat oleh syarat dan ketentuan berikut (&quot;Persyaratan&quot;). Jika Anda tidak menerima syarat-syarat ini, harap hentikan akses ke situs Megavision dan layanan online terkait lainnya. Kami setiap saat dapat merevisi Persyaratan ini dengan memperbarui versi terkini untuk mencerminkan perubahan aktivitas kami."
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.6"
                    android:textAlignment="textStart"
                    android:layout_marginBottom="20dp" />

                <!-- Section 2 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2. Copyright and Trademark Notices"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Semua merek dagang yang dimiliki oleh Megavision dan afiliasinya—termasuk konten, grafik, desain, kompilasi, konversi digital, dan hal-hal lain yang terkait dengan nama Megavision—dilindungi oleh hak cipta, merek dagang, dan hak kepemilikan lainnya. Selain yang secara tegas diizinkan, penyalinan, pendistribusian ulang, penggunaan, atau publikasi oleh Anda dari hal-hal tersebut, atau bagian mana pun dari Megavision, sangat dilarang."
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.6"
                    android:textAlignment="textStart"
                    android:layout_marginBottom="20dp" />

                <!-- Section 3 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3. Disclaimer"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Semua informasi di Megavision Apps diterbitkan dengan itikad baik dan hanya untuk tujuan informasi umum. Megavision tidak memberikan jaminan apa pun tentang kelengkapan, keandalan, dan keakuratan informasi ini. Segala tindakan yang Anda ambil atas informasi yang Anda temukan di situs web ini sepenuhnya merupakan tanggung jawab Anda sendiri. Megavision tidak akan bertanggung jawab atas kerugian dan kerusakan sehubungan dengan penggunaan situs web kami."
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.6"
                    android:textAlignment="textStart"
                    android:layout_marginBottom="20dp" />

                <!-- Tambahkan section lebih lanjut sesuai kebutuhan -->

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>