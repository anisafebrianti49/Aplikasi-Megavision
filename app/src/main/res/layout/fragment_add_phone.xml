<?xml version="1.0" encoding="utf-8"?>
<!-- fragment_add_phone.xml -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:paddingHorizontal="24dp">

    <!-- Tombol Back -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_arrow_back"
        android:background="@drawable/bg_back_button"
        android:contentDescription="Kembali"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Judul -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Tambahkan Nomor Telepon"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Deskripsi -->
    <TextView
        android:id="@+id/tv_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Kami akan mengirimkan kode rahasia ke nomor ponsel Anda untuk tujuan verifikasi, mohon pastikan nomor Anda sedang aktif"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:lineSpacingMultiplier="1.5"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Label Telepon -->
    <TextView
        android:id="@+id/tv_label_telepon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Telepon"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tv_description"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_nomor_telepon"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Nomor Telepon Anda"
        app:startIconDrawable="@drawable/ic_phone"
        app:startIconTint="@color/megavision_blue"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxStrokeColor="@color/selector_input_stroke"
        app:hintTextColor="@color/text_hint"
        app:boxBackgroundColor="@color/white"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_label_telepon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_nomor_telepon"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:inputType="phone"
            android:textColor="@color/text_primary"
            android:textSize="15sp"

            android:paddingLeft="48dp"
            android:paddingStart="48dp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Tombol Simpan -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_simpan"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Simpan"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:enabled="false"
        android:alpha="0.5"
        app:backgroundTint="@color/megavision_blue"
        app:cornerRadius="16dp"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toBottomOf="@id/til_nomor_telepon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>