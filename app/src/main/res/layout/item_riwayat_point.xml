<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="#EAEAEA"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Ikon Koin -->
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/coin" />

        <!-- Info Teks -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- ID UNTUK JUDUL DITAMBAHKAN DI SINI -->
            <TextView
                android:id="@+id/tvJudulRiwayat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pembayaran Tagihan"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- ID UNTUK TANGGAL DITAMBAHKAN DI SINI -->
            <TextView
                android:id="@+id/tvTanggalRiwayat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="23 Juni 2026 • 14:30 WIB"
                android:textColor="#757575"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ID UNTUK JUMLAH POIN DITAMBAHKAN DI SINI -->
        <TextView
            android:id="@+id/tvJumlahPoin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+50 Poin"
            android:textColor="#00A050"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>