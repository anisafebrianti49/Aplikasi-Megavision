<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_blue"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:ignore="HardcodedText,Contrast,VisualLintButtonSize">

    <!-- Header Transparan & Tombol Back Berkuran Standar (48dp) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@android:color/transparent">

        <ImageView
            android:id="@+id/btn_back_detail_upgrade"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="4dp"
            android:src="@android:drawable/ic_menu_revert"
            android:scaleType="centerInside"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Kembali"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Bantuan"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Menggunakan ScrollView Tunggal agar Seluruh Konten Rapat Ke Atas -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Bagian Pertanyaan -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❓ Pertanyaan :"
                android:textColor="#D0E0FC"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_pertanyaan_upgrade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Bagaimana cara mengukur kecepatan Internet Megavision?"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Garis Pembatas Tipis Estetik -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#40FFFFFF"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />

            <!-- Wadah CardView Putih Untuk Solusi -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="❶ Solusi"
                        android:textColor="#1A60D1"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_deskripsi_solusi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Memuat solusi dari database..."
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.3" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Posisi Baru: Teks Pertanyaan Konfirmasi (Diubah Menjadi Putih) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="30dp"
                android:text="Apakah saran ini menyelesaikan masalah Anda?"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="14sp" />

            <!-- Tombol Ya (Biru Modern) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_ya_solusi"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#1A60D1"
                android:text="Ya, masalah terpecahkan"
                android:textColor="#FFFFFF"
                android:textAllCaps="false" />

            <!-- Tombol Tidak (Abu-abu Lembut Modern) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_tidak_solusi"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                android:backgroundTint="#CBD5E1"
                android:text="Tidak, saya butuh solusi lain"
                android:textColor="#333333"
                android:textAllCaps="false" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>