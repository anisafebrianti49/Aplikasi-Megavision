<?xml version="1.0" encoding="utf-8"?>
<!-- fragment_logout_bottom_sheet.xml -->
<!--
    Layout untuk BottomSheetDialogFragment.
    Sudut atas melengkung ditangani oleh style BottomSheet,
    tapi kita juga set di sini untuk memastikan tampilan card-like.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingBottom="24dp">

    <!-- Handle indicator (pill abu-abu di atas) -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Header: Judul + Tombol Tutup -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keluar"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageButton
            android:id="@+id/btn_tutup"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:background="@drawable/bg_icon_button_gray"
            android:contentDescription="Tutup"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0F0F0" />

    <!-- Pesan Konfirmasi -->
    <TextView
        android:id="@+id/tv_konfirmasi_pesan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp"
        android:text="Anda akan keluar dari akun Rubby Ferdiansyah, lanjutkan?"
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        android:lineSpacingMultiplier="1.5" />

    <!-- Spacer -->
    <View android:layout_width="match_parent" android:layout_height="16dp" />

    <!-- Tombol Konfirmasi Keluar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_konfirmasi_keluar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Konfirmasi Keluar"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:backgroundTint="@color/megavision_blue"
        app:cornerRadius="16dp"
        android:layout_marginHorizontal="20dp" />

    <!-- Tombol Batal -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_batal"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Batal"
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp" />

</LinearLayout>